# ==============================================================================
# TeamFund Environment Variables Configuration
# ==============================================================================
# Copy this file to '.env.local' or '.env' and fill in your actual credentials:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI API Key (Required for AI Insights & Spending Suggestions)
# ------------------------------------------------------------------------------
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Firebase Configuration (Optional - for real-time cloud multi-device sync)
# ------------------------------------------------------------------------------
# If omitted or left blank, TeamFund will automatically run in Offline Mode 
# and persist all data safely in browser LocalStorage.
#
# Obtain from: Firebase Console > Project Settings > General > Web Apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=teamfund-b6c6a.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://teamfund-b6c6a-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=teamfund-b6c6a
VITE_FIREBASE_STORAGE_BUCKET=teamfund-b6c6a.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
